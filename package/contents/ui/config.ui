<ui version="4.0">
  <class>KWin::PaftaConfigForm</class>
  <widget class="QWidget" name="KWin::PaftaConfigForm">
    <layout class="QVBoxLayout" name="mainLayout">
      <item>
        <widget class="QTabWidget" name="tabs">
          <widget class="QWidget" name="compassTab">
            <attribute name="title">
              <string>Compass</string>
            </attribute>
            <layout class="QVBoxLayout" name="compassTabLayout">
              <item>
                <spacer name="compassTop">
                  <property name="orientation">
                    <enum>Qt::Vertical</enum>
                  </property>
                  <property name="sizeHint">
                    <size>
                      <width>0</width>
                      <height>0</height>
                    </size>
                  </property>
                </spacer>
              </item>
              <item>
                <layout class="QHBoxLayout" name="compassRow">
                  <item>
                    <spacer name="compassLeft">
                      <property name="orientation">
                        <enum>Qt::Horizontal</enum>
                      </property>
                      <property name="sizeHint">
                        <size>
                          <width>0</width>
                          <height>0</height>
                        </size>
                      </property>
                    </spacer>
                  </item>
                  <item>
                    <widget class="QStackedWidget" name="compassPreview">
                      <widget class="QLabel" name="compassPreview_off">
                        <property name="text">
                          <string>&lt;img src="data:image/svg+xml;base64,"&gt;</string>
                        </property>
                        <property name="alignment">
                          <set>Qt::AlignVCenter|Qt::AlignHCenter</set>
                        </property>
                      </widget>
                      <widget class="QLabel" name="compassPreview_quarters">
                        <property name="text">
                          <string>&lt;img src="data:image/svg+xml;base64,"&gt;</string>
                        </property>
                        <property name="alignment">
                          <set>Qt::AlignVCenter|Qt::AlignHCenter</set>
                        </property>
                      </widget>
                      <widget class="QLabel" name="compassPreview_rings">
                        <property name="text">
                          <string>&lt;img src="data:image/svg+xml;base64,"&gt;</string>
                        </property>
                        <property name="alignment">
                          <set>Qt::AlignVCenter|Qt::AlignHCenter</set>
                        </property>
                      </widget>
                    </widget>
                  </item>
                  <item>
                    <spacer name="compassGap">
                      <property name="orientation">
                        <enum>Qt::Horizontal</enum>
                      </property>
                      <property name="sizeType">
                        <enum>QSizePolicy::Fixed</enum>
                      </property>
                      <property name="sizeHint">
                        <size>
                          <width>24</width>
                          <height>0</height>
                        </size>
                      </property>
                    </spacer>
                  </item>
                  <item>
                    <layout class="QVBoxLayout" name="compassSide">
                      <item>
                        <spacer name="sideTop">
                          <property name="orientation">
                            <enum>Qt::Vertical</enum>
                          </property>
                          <property name="sizeHint">
                            <size>
                              <width>0</width>
                              <height>0</height>
                            </size>
                          </property>
                        </spacer>
                      </item>
                      <item>
                        <layout class="QFormLayout" name="compassForm">
                          <property name="fieldGrowthPolicy">
                            <enum>QFormLayout::FieldsStayAtSizeHint</enum>
                          </property>
                          <item row="0" column="0">
                            <widget class="QLabel">
                              <property name="text">
                                <string>Opens after:</string>
                              </property>
                            </widget>
                          </item>
                          <item row="0" column="1">
                            <widget class="QSpinBox" name="kcfg_dwellMs">
                              <property name="minimum">
                                <number>0</number>
                              </property>
                              <property name="maximum">
                                <number>1000</number>
                              </property>
                              <property name="singleStep">
                                <number>50</number>
                              </property>
                              <property name="suffix">
                                <string> ms</string>
                              </property>
                              <property name="specialValueText">
                                <string>Immediately</string>
                              </property>
                              <property name="toolTip">
                                <string>How long the cursor rests before the compass opens. Immediately: as soon as you grab the window, once per drag.</string>
                              </property>
                            </widget>
                          </item>
                          <item row="1" column="0">
                            <widget class="QLabel">
                              <property name="text">
                                <string>Size:</string>
                              </property>
                            </widget>
                          </item>
                          <item row="1" column="1">
                            <widget class="QComboBox" name="kcfg_compassSize">
                              <item>
                                <property name="text">
                                  <string>Small</string>
                                </property>
                              </item>
                              <item>
                                <property name="text">
                                  <string>Medium</string>
                                </property>
                              </item>
                              <item>
                                <property name="text">
                                  <string>Large</string>
                                </property>
                              </item>
                            </widget>
                          </item>
                          <item row="2" column="0">
                            <widget class="QLabel">
                              <property name="text">
                                <string>Center:</string>
                              </property>
                            </widget>
                          </item>
                          <item row="2" column="1">
                            <widget class="QComboBox" name="kcfg_compassCenter">
                              <item>
                                <property name="text">
                                  <string>Own size, centered</string>
                                </property>
                              </item>
                              <item>
                                <property name="text">
                                  <string>Centered window</string>
                                </property>
                              </item>
                              <item>
                                <property name="text">
                                  <string>Fill the screen (not maximized)</string>
                                </property>
                              </item>
                              <item>
                                <property name="text">
                                  <string>Maximize</string>
                                </property>
                              </item>
                              <item>
                                <property name="text">
                                  <string>Top half</string>
                                </property>
                              </item>
                              <item>
                                <property name="text">
                                  <string>Bottom half</string>
                                </property>
                              </item>
                              <item>
                                <property name="text">
                                  <string>Nothing</string>
                                </property>
                              </item>
                            </widget>
                          </item>
                          <item row="3" column="0">
                            <widget class="QLabel">
                              <property name="text">
                                <string>North:</string>
                              </property>
                            </widget>
                          </item>
                          <item row="3" column="1">
                            <widget class="QComboBox" name="kcfg_compassNorth">
                              <item>
                                <property name="text">
                                  <string>Own size, centered</string>
                                </property>
                              </item>
                              <item>
                                <property name="text">
                                  <string>Centered window</string>
                                </property>
                              </item>
                              <item>
                                <property name="text">
                                  <string>Fill the screen (not maximized)</string>
                                </property>
                              </item>
                              <item>
                                <property name="text">
                                  <string>Maximize</string>
                                </property>
                              </item>
                              <item>
                                <property name="text">
                                  <string>Top half</string>
                                </property>
                              </item>
                              <item>
                                <property name="text">
                                  <string>Bottom half</string>
                                </property>
                              </item>
                              <item>
                                <property name="text">
                                  <string>Nothing</string>
                                </property>
                              </item>
                            </widget>
                          </item>
                          <item row="4" column="0">
                            <widget class="QLabel">
                              <property name="text">
                                <string>South:</string>
                              </property>
                            </widget>
                          </item>
                          <item row="4" column="1">
                            <widget class="QComboBox" name="kcfg_compassSouth">
                              <item>
                                <property name="text">
                                  <string>Own size, centered</string>
                                </property>
                              </item>
                              <item>
                                <property name="text">
                                  <string>Centered window</string>
                                </property>
                              </item>
                              <item>
                                <property name="text">
                                  <string>Fill the screen (not maximized)</string>
                                </property>
                              </item>
                              <item>
                                <property name="text">
                                  <string>Maximize</string>
                                </property>
                              </item>
                              <item>
                                <property name="text">
                                  <string>Top half</string>
                                </property>
                              </item>
                              <item>
                                <property name="text">
                                  <string>Bottom half</string>
                                </property>
                              </item>
                              <item>
                                <property name="text">
                                  <string>Nothing</string>
                                </property>
                              </item>
                            </widget>
                          </item>
                          <item row="5" column="0">
                            <widget class="QLabel">
                              <property name="text">
                                <string>West and east:</string>
                              </property>
                            </widget>
                          </item>
                          <item row="5" column="1">
                            <widget class="QLineEdit" name="kcfg_compassRings">
                              <property name="toolTip">
                                <string>Widths in percent, one to four, narrowest nearest the center.</string>
                              </property>
                              <property name="placeholderText">
                                <string>33, 50, 67</string>
                              </property>
                              <property name="maximumWidth">
                                <number>140</number>
                              </property>
                            </widget>
                          </item>
                          <item row="6" column="0">
                            <widget class="QLabel">
                              <property name="text">
                                <string>Diagonals:</string>
                              </property>
                            </widget>
                          </item>
                          <item row="6" column="1">
                            <widget class="QComboBox" name="kcfg_compassCorners">
                              <item>
                                <property name="text">
                                  <string>Off</string>
                                </property>
                              </item>
                              <item>
                                <property name="text">
                                  <string>Corner quarters</string>
                                </property>
                              </item>
                              <item>
                                <property name="text">
                                  <string>Corner quarters in the widths above</string>
                                </property>
                              </item>
                            </widget>
                          </item>
                          <item row="7" column="0">
                            <widget class="QLabel">
                              <property name="text">
                                <string>Centered window:</string>
                              </property>
                            </widget>
                          </item>
                          <item row="7" column="1">
                            <layout class="QHBoxLayout" name="centeredRow">
                              <item>
                                <widget class="QSpinBox" name="kcfg_centeredWidth">
                                  <property name="minimum">
                                    <number>10</number>
                                  </property>
                                  <property name="maximum">
                                    <number>100</number>
                                  </property>
                                  <property name="singleStep">
                                    <number>5</number>
                                  </property>
                                  <property name="suffix">
                                    <string> %</string>
                                  </property>
                                  <property name="toolTip">
                                    <string>Width</string>
                                  </property>
                                </widget>
                              </item>
                              <item>
                                <widget class="QLabel">
                                  <property name="text">
                                    <string>×</string>
                                  </property>
                                </widget>
                              </item>
                              <item>
                                <widget class="QSpinBox" name="kcfg_centeredHeight">
                                  <property name="minimum">
                                    <number>10</number>
                                  </property>
                                  <property name="maximum">
                                    <number>100</number>
                                  </property>
                                  <property name="singleStep">
                                    <number>5</number>
                                  </property>
                                  <property name="suffix">
                                    <string> %</string>
                                  </property>
                                  <property name="toolTip">
                                    <string>Height</string>
                                  </property>
                                </widget>
                              </item>
                              <item>
                                <spacer name="centeredSpacer">
                                  <property name="orientation">
                                    <enum>Qt::Horizontal</enum>
                                  </property>
                                  <property name="sizeHint">
                                    <size>
                                      <width>0</width>
                                      <height>0</height>
                                    </size>
                                  </property>
                                </spacer>
                              </item>
                            </layout>
                          </item>
                        </layout>
                      </item>
                      <item>
                        <widget class="QLabel">
                          <property name="text">
                            <string>Grab a window and the compass opens around the cursor; drop on a slot to place the window. Own size is the size the application first opened with, or the size you last gave it by hand. Move away from the compass and drop to leave the window where it is; Esc cancels the move.</string>
                          </property>
                          <property name="wordWrap">
                            <bool>true</bool>
                          </property>
                          <property name="maximumWidth">
                            <number>440</number>
                          </property>
                        </widget>
                      </item>
                      <item>
                        <spacer name="sideBottom">
                          <property name="orientation">
                            <enum>Qt::Vertical</enum>
                          </property>
                          <property name="sizeHint">
                            <size>
                              <width>0</width>
                              <height>0</height>
                            </size>
                          </property>
                        </spacer>
                      </item>
                    </layout>
                  </item>
                  <item>
                    <spacer name="compassRight">
                      <property name="orientation">
                        <enum>Qt::Horizontal</enum>
                      </property>
                      <property name="sizeHint">
                        <size>
                          <width>0</width>
                          <height>0</height>
                        </size>
                      </property>
                    </spacer>
                  </item>
                </layout>
              </item>
              <item>
                <spacer name="compassTabSpacer">
                  <property name="orientation">
                    <enum>Qt::Vertical</enum>
                  </property>
                  <property name="sizeHint">
                    <size>
                      <width>0</width>
                      <height>0</height>
                    </size>
                  </property>
                </spacer>
              </item>
            </layout>
          </widget>
          <widget class="QWidget" name="behaviorTab">
            <attribute name="title">
              <string>Behavior</string>
            </attribute>
            <layout class="QVBoxLayout" name="behaviorTabLayout">
              <item>
                <layout class="QFormLayout" name="behaviorForm">
                  <item row="0" column="1">
                    <widget class="QCheckBox" name="kcfg_remember">
                      <property name="text">
                        <string>Remember where applications were placed</string>
                      </property>
                      <property name="toolTip">
                        <string>When an application closes, its tile, position or maximized state is saved and restored the next time it opens.</string>
                      </property>
                    </widget>
                  </item>
                  <item row="1" column="1">
                    <widget class="QCheckBox" name="kcfg_restoreMaximized">
                      <property name="text">
                        <string>Un-maximize windows to where they were, back into their tile</string>
                      </property>
                    </widget>
                  </item>
                  <item row="2" column="1">
                    <widget class="QCheckBox" name="kcfg_debug">
                      <property name="text">
                        <string>Debug logging</string>
                      </property>
                    </widget>
                  </item>
                </layout>
              </item>
              <item>
                <widget class="QLabel">
                  <property name="text">
                    <string>Layouts come from Plasma: press Meta+T to draw the tiles of each virtual desktop, and drag with Shift to drop a window into them. The compass never puts windows into tiles, so they stay free to resize.</string>
                  </property>
                  <property name="wordWrap">
                    <bool>true</bool>
                  </property>
                </widget>
              </item>
              <item>
                <spacer name="behaviorTabSpacer">
                  <property name="orientation">
                    <enum>Qt::Vertical</enum>
                  </property>
                  <property name="sizeHint">
                    <size>
                      <width>0</width>
                      <height>0</height>
                    </size>
                  </property>
                </spacer>
              </item>
            </layout>
          </widget>
          <widget class="QWidget" name="exceptionsTab">
            <attribute name="title">
              <string>Exceptions</string>
            </attribute>
            <layout class="QVBoxLayout" name="exceptionsTabLayout">
              <item>
                <widget class="QLabel">
                  <property name="text">
                    <string>Window classes pafta leaves alone, one per line:</string>
                  </property>
                  <property name="wordWrap">
                    <bool>true</bool>
                  </property>
                </widget>
              </item>
              <item>
                <widget class="QPlainTextEdit" name="kcfg_exceptions"/>
              </item>
              <item>
                <spacer name="exceptionsTabSpacer">
                  <property name="orientation">
                    <enum>Qt::Vertical</enum>
                  </property>
                  <property name="sizeHint">
                    <size>
                      <width>0</width>
                      <height>0</height>
                    </size>
                  </property>
                </spacer>
              </item>
            </layout>
          </widget>
        </widget>
      </item>
      <item>
        <widget class="QLabel">
          <property name="text">
            <string>Changes apply to the next drag.</string>
          </property>
          <property name="wordWrap">
            <bool>true</bool>
          </property>
        </widget>
      </item>
    </layout>
  </widget>
  <resources/>
  <connections>
    <connection>
      <sender>kcfg_compassCorners</sender>
      <signal>currentIndexChanged(int)</signal>
      <receiver>compassPreview</receiver>
      <slot>setCurrentIndex(int)</slot>
    </connection>
  </connections>
</ui>
