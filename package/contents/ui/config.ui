<ui version="4.0">
  <class>KWin::PaftaConfigForm</class>
  <widget class="QWidget" name="KWin::PaftaConfigForm">
    <layout class="QVBoxLayout" name="mainLayout">
      <item>
        <widget class="QTabWidget" name="tabs">
          <widget class="QWidget" name="layoutTab">
            <attribute name="title">
              <string>Layout &amp;&amp; Compass</string>
            </attribute>
            <layout class="QVBoxLayout" name="layoutTabLayout">
              <item>
                <spacer name="compassTop">
                  <property name="orientation">
                    <enum>Qt::Vertical</enum>
                  </property>
                  <property name="sizeHint">
                    <size>
                      <width>0</width>
                      <height>0</height>
                    </size>
                  </property>
                </spacer>
              </item>
              <item>
                <layout class="QHBoxLayout" name="compassRow">
                  <item>
                    <spacer name="compassLeft">
                      <property name="orientation">
                        <enum>Qt::Horizontal</enum>
                      </property>
                      <property name="sizeHint">
                        <size>
                          <width>0</width>
                          <height>0</height>
                        </size>
                      </property>
                    </spacer>
                  </item>
                  <item>
                    <widget class="QLabel" name="compassPreview">
                      <property name="text">
                        <string>&lt;img src="data:image/svg+xml;base64,"&gt;</string>
                      </property>
                      <property name="alignment">
                        <set>Qt::AlignVCenter|Qt::AlignHCenter</set>
                      </property>
                    </widget>
                  </item>
                  <item>
                    <spacer name="compassGap">
                      <property name="orientation">
                        <enum>Qt::Horizontal</enum>
                      </property>
                      <property name="sizeType">
                        <enum>QSizePolicy::Fixed</enum>
                      </property>
                      <property name="sizeHint">
                        <size>
                          <width>24</width>
                          <height>0</height>
                        </size>
                      </property>
                    </spacer>
                  </item>
                  <item>
                    <layout class="QVBoxLayout" name="compassSide">
                      <item>
                        <spacer name="sideTop">
                          <property name="orientation">
                            <enum>Qt::Vertical</enum>
                          </property>
                          <property name="sizeHint">
                            <size>
                              <width>0</width>
                              <height>0</height>
                            </size>
                          </property>
                        </spacer>
                      </item>
                      <item>
                        <layout class="QFormLayout" name="layoutForm">
                          <property name="fieldGrowthPolicy">
                            <enum>QFormLayout::FieldsStayAtSizeHint</enum>
                          </property>
                          <item row="0" column="0">
                            <widget class="QLabel">
                              <property name="text">
                                <string>Left split:</string>
                              </property>
                            </widget>
                          </item>
                          <item row="0" column="1">
                            <widget class="QSpinBox" name="kcfg_split">
                              <property name="minimum">
                                <number>25</number>
                              </property>
                              <property name="maximum">
                                <number>75</number>
                              </property>
                              <property name="singleStep">
                                <number>5</number>
                              </property>
                              <property name="suffix">
                                <string> %</string>
                              </property>
                              <property name="toolTip">
                                <string>Left column percentage; right column uses the remainder.</string>
                              </property>
                            </widget>
                          </item>
                          <item row="1" column="0">
                            <widget class="QLabel">
                              <property name="text">
                                <string>Outer left / right (X):</string>
                              </property>
                            </widget>
                          </item>
                          <item row="1" column="1">
                            <widget class="QSpinBox" name="kcfg_outerX">
                              <property name="minimum">
                                <number>0</number>
                              </property>
                              <property name="maximum">
                                <number>80</number>
                              </property>
                              <property name="singleStep">
                                <number>2</number>
                              </property>
                              <property name="suffix">
                                <string> px</string>
                              </property>
                              <property name="toolTip">
                                <string>Horizontal margin against the left and right screen edges.</string>
                              </property>
                            </widget>
                          </item>
                          <item row="2" column="0">
                            <widget class="QLabel">
                              <property name="text">
                                <string>Outer top / bottom (Y):</string>
                              </property>
                            </widget>
                          </item>
                          <item row="2" column="1">
                            <widget class="QSpinBox" name="kcfg_outerY">
                              <property name="minimum">
                                <number>0</number>
                              </property>
                              <property name="maximum">
                                <number>80</number>
                              </property>
                              <property name="singleStep">
                                <number>2</number>
                              </property>
                              <property name="suffix">
                                <string> px</string>
                              </property>
                              <property name="toolTip">
                                <string>Vertical margin against the top and bottom screen edges.</string>
                              </property>
                            </widget>
                          </item>
                          <item row="3" column="0">
                            <widget class="QLabel">
                              <property name="text">
                                <string>Inner gap:</string>
                              </property>
                            </widget>
                          </item>
                          <item row="3" column="1">
                            <widget class="QSpinBox" name="kcfg_innerGap">
                              <property name="minimum">
                                <number>0</number>
                              </property>
                              <property name="maximum">
                                <number>60</number>
                              </property>
                              <property name="singleStep">
                                <number>2</number>
                              </property>
                              <property name="suffix">
                                <string> px</string>
                              </property>
                              <property name="toolTip">
                                <string>Gap between Left and Right columns.</string>
                              </property>
                            </widget>
                          </item>
                          <item row="4" column="0">
                            <widget class="QLabel">
                              <property name="text">
                                <string>Center size:</string>
                              </property>
                            </widget>
                          </item>
                          <item row="4" column="1">
                            <layout class="QHBoxLayout" name="centeredRow">
                              <item>
                                <widget class="QSpinBox" name="kcfg_centerWidth">
                                  <property name="minimum">
                                    <number>20</number>
                                  </property>
                                  <property name="maximum">
                                    <number>95</number>
                                  </property>
                                  <property name="singleStep">
                                    <number>2</number>
                                  </property>
                                  <property name="suffix">
                                    <string> %</string>
                                  </property>
                                  <property name="toolTip">
                                    <string>Center box width</string>
                                  </property>
                                </widget>
                              </item>
                              <item>
                                <widget class="QLabel">
                                  <property name="text">
                                    <string>×</string>
                                  </property>
                                </widget>
                              </item>
                              <item>
                                <widget class="QSpinBox" name="kcfg_centerHeight">
                                  <property name="minimum">
                                    <number>20</number>
                                  </property>
                                  <property name="maximum">
                                    <number>95</number>
                                  </property>
                                  <property name="singleStep">
                                    <number>2</number>
                                  </property>
                                  <property name="suffix">
                                    <string> %</string>
                                  </property>
                                  <property name="toolTip">
                                    <string>Center box height</string>
                                  </property>
                                </widget>
                              </item>
                              <item>
                                <spacer name="centeredSpacer">
                                  <property name="orientation">
                                    <enum>Qt::Horizontal</enum>
                                  </property>
                                  <property name="sizeHint">
                                    <size>
                                      <width>0</width>
                                      <height>0</height>
                                    </size>
                                  </property>
                                </spacer>
                              </item>
                            </layout>
                          </item>
                          <item row="5" column="0">
                            <widget class="QLabel">
                              <property name="text">
                                <string>Compass size:</string>
                              </property>
                            </widget>
                          </item>
                          <item row="5" column="1">
                            <widget class="QComboBox" name="kcfg_compassSize">
                              <item>
                                <property name="text">
                                  <string>Small</string>
                                </property>
                              </item>
                              <item>
                                <property name="text">
                                  <string>Medium</string>
                                </property>
                              </item>
                              <item>
                                <property name="text">
                                  <string>Large</string>
                                </property>
                              </item>
                            </widget>
                          </item>
                        </layout>
                      </item>
                      <item>
                        <widget class="QLabel">
                          <property name="text">
                            <string>Drag any window freely anywhere on screen. Pull to the top edge to open the 4-sector compass (West = Left split, East = Right split, North = Fill, South = Center, Hub = Free). Pull down to dismiss, or use Meta+Left / Meta+Right / Meta+Up / Meta+Down.</string>
                          </property>
                          <property name="wordWrap">
                            <bool>true</bool>
                          </property>
                          <property name="maximumWidth">
                            <number>440</number>
                          </property>
                        </widget>
                      </item>
                      <item>
                        <spacer name="sideBottom">
                          <property name="orientation">
                            <enum>Qt::Vertical</enum>
                          </property>
                          <property name="sizeHint">
                            <size>
                              <width>0</width>
                              <height>0</height>
                            </size>
                          </property>
                        </spacer>
                      </item>
                    </layout>
                  </item>
                  <item>
                    <spacer name="compassRight">
                      <property name="orientation">
                        <enum>Qt::Horizontal</enum>
                      </property>
                      <property name="sizeHint">
                        <size>
                          <width>0</width>
                          <height>0</height>
                        </size>
                      </property>
                    </spacer>
                  </item>
                </layout>
              </item>
              <item>
                <spacer name="layoutTabSpacer">
                  <property name="orientation">
                    <enum>Qt::Vertical</enum>
                  </property>
                  <property name="sizeHint">
                    <size>
                      <width>0</width>
                      <height>0</height>
                    </size>
                  </property>
                </spacer>
              </item>
            </layout>
          </widget>
          <widget class="QWidget" name="behaviorTab">
            <attribute name="title">
              <string>Behavior</string>
            </attribute>
            <layout class="QVBoxLayout" name="behaviorTabLayout">
              <item>
                <layout class="QFormLayout" name="behaviorForm">
                  <item row="0" column="1">
                    <widget class="QCheckBox" name="kcfg_remember">
                      <property name="text">
                        <string>Remember where applications were placed</string>
                      </property>
                      <property name="toolTip">
                        <string>Saves moves, resizes, slots, and maximized states immediately and restores the app's first window on Wayland.</string>
                      </property>
                    </widget>
                  </item>
                  <item row="1" column="1">
                    <widget class="QCheckBox" name="kcfg_restoreMaximized">
                      <property name="text">
                        <string>Un-maximize windows back to their previous position</string>
                      </property>
                    </widget>
                  </item>
                  <item row="2" column="1">
                    <widget class="QCheckBox" name="kcfg_debug">
                      <property name="text">
                        <string>Debug logging</string>
                      </property>
                    </widget>
                  </item>
                </layout>
              </item>
              <item>
                <widget class="QLabel">
                  <property name="text">
                    <string>pafta uses its own frameGeometry layout and never modifies Plasma Meta+T tiles.</string>
                  </property>
                  <property name="wordWrap">
                    <bool>true</bool>
                  </property>
                </widget>
              </item>
              <item>
                <spacer name="behaviorTabSpacer">
                  <property name="orientation">
                    <enum>Qt::Vertical</enum>
                  </property>
                  <property name="sizeHint">
                    <size>
                      <width>0</width>
                      <height>0</height>
                    </size>
                  </property>
                </spacer>
              </item>
            </layout>
          </widget>
          <widget class="QWidget" name="exceptionsTab">
            <attribute name="title">
              <string>Exceptions</string>
            </attribute>
            <layout class="QVBoxLayout" name="exceptionsTabLayout">
              <item>
                <widget class="QLabel">
                  <property name="text">
                    <string>Window classes pafta leaves alone, one per line:</string>
                  </property>
                  <property name="wordWrap">
                    <bool>true</bool>
                  </property>
                </widget>
              </item>
              <item>
                <widget class="QPlainTextEdit" name="kcfg_exceptions"/>
              </item>
              <item>
                <spacer name="exceptionsTabSpacer">
                  <property name="orientation">
                    <enum>Qt::Vertical</enum>
                  </property>
                  <property name="sizeHint">
                    <size>
                      <width>0</width>
                      <height>0</height>
                    </size>
                  </property>
                </spacer>
              </item>
            </layout>
          </widget>
        </widget>
      </item>
      <item>
        <widget class="QLabel">
          <property name="text">
            <string>Changes apply on the next drag or shortcut.</string>
          </property>
          <property name="wordWrap">
            <bool>true</bool>
          </property>
        </widget>
      </item>
    </layout>
  </widget>
  <resources/>
  <connections/>
</ui>
